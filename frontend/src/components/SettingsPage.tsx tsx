import { useState } from 'react'
import { useSettingsStore } from '@/stores/settingsStore'
import { AIProvider } from '@/types'

const PROVIDERS: { id: AIProvider; name: string; model: string; limit: string; url: string }[] = [
  { id: 'openrouter', name: 'OpenRouter', model: 'Qwen 32B (free)', limit: '20 req/min', url: 'openrouter.ai/keys' },
  { id: 'gemini',     name: 'Google Gemini', model: 'Gemini 1.5 Flash', limit: '15 req/min', url: 'aistudio.google.com' },
  { id: 'groq',       name: 'GroqCloud', model: 'Llama 3 70B', limit: '30 req/min', url: 'console.groq.com' },
]

export function SettingsPage() {
  const { ai_provider, openrouter_key, gemini_key, groq_key, etherscan_key, setProvider, setKey } = useSettingsStore()
  const [saved, setSaved] = useState(false)
  const [show, setShow] = useState<Record<string,boolean>>({})

  const keyFor = (id: string) => id==='openrouter' ? openrouter_key : id==='gemini' ? gemini_key : groq_key

  const handleSave = () => { setSaved(true); setTimeout(() => setSaved(false), 2000) }

  return (
    <div className="flex-1 overflow-y-auto p-6 max-w-2xl mx-auto w-full">
      <h2 className="text-sm font-display text-cyan-DEFAULT tracking-widest mb-6">SETTINGS</h2>

      {/* AI Provider */}
      <section className="mb-6">
        <p className="text-[10px] text-[#333] uppercase tracking-widest mb-3">AI Provider (Free)</p>
        <div className="flex flex-col gap-2">
          {PROVIDERS.map(p => (
            <div key={p.id} onClick={() => setProvider(p.id)}
              className="flex items-center gap-3 p-3 rounded border cursor-pointer transition-all"
              style={{borderColor: ai_provider===p.id ? 'rgba(0,255,255,0.3)' : '#1e1e1e', background: ai_provider===p.id ? 'rgba(0,255,255,0.03)' : '#0d0d0d'}}>
              <div className="w-3 h-3 rounded-full border-2 flex items-center justify-center shrink-0"
                style={{borderColor: ai_provider===p.id ? '#00ffff' : '#2a2a2a'}}>
                {ai_provider===p.id && <div className="w-1.5 h-1.5 rounded-full bg-cyan-DEFAULT" />}
              </div>
              <div className="flex-1 min-w-0">
                <p className="text-xs text-[#bbb]">{p.name} <span className="text-[#333]">·</span> <span className="text-[10px] text-[#444]">{p.model}</span></p>
                <p className="text-[9px] text-[#333]">{p.limit} · {p.url}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* API Keys */}
      <section className="mb-6">
        <p className="text-[10px] text-[#333] uppercase tracking-widest mb-3">API Keys</p>
        <div className="flex flex-col gap-3">
          {PROVIDERS.map(p => (
            <div key={p.id} className="flex flex-col gap-1">
              <label className="text-[9px] text-[#444] uppercase tracking-widest">{p.name} Key</label>
              <div className="flex gap-2">
                <input
                  type={show[p.id] ? 'text' : 'password'}
                  value={keyFor(p.id)}
                  onChange={e => setKey(p.id, e.target.value)}
                  placeholder={`${p.id === 'openrouter' ? 'sk-or-v1-...' : p.id === 'gemini' ? 'AIza...' : 'gsk_...'}`}
                  className="flex-1 bg-[#0d0d0d] border border-[#1e1e1e] text-[#888] font-mono text-xs px-3 py-2 rounded focus:outline-none focus:border-cyan-DEFAULT/30"
                />
                <button onClick={() => setShow(s => ({...s,[p.id]:!s[p.id]}))}
                  className="px-3 py-2 border border-[#1e1e1e] text-[#444] text-xs rounded hover:border-[#2a2a2a]">
                  {show[p.id] ? '🙈' : '👁'}
                </button>
              </div>
            </div>
          ))}
          <div className="flex flex-col gap-1">
            <label className="text-[9px] text-[#444] uppercase tracking-widest">Etherscan API Key (optional)</label>
            <input type={show['eth'] ? 'text' : 'password'} value={etherscan_key} onChange={e => setKey('etherscan', e.target.value)}
              placeholder="YourApiKeyToken"
              className="bg-[#0d0d0d] border border-[#1e1e1e] text-[#888] font-mono text-xs px-3 py-2 rounded focus:outline-none focus:border-cyan-DEFAULT/30" />
          </div>
        </div>
      </section>

      <button onClick={handleSave}
        className="px-8 py-2 border border-cyan-DEFAULT text-cyan-DEFAULT font-mono text-xs tracking-widest rounded hover:bg-cyan-glow transition-all">
        {saved ? '✓ Saved' : 'Save Settings'}
      </button>

      <div className="mt-8 p-4 bg-[#0d0d0d] border border-[#1a1a1a] rounded">
        <p className="text-[10px] text-[#333] uppercase tracking-widest mb-2">Tool Status</p>
        <p className="text-[10px] text-[#444] font-mono">Install Slither + Mythril on your computer:</p>
        <pre className="text-[10px] text-[#555] mt-2 leading-relaxed">pip install slither-analyzer mythril{'\n'}pip install solc-select{'\n'}solc-select install 0.8.20</pre>
      </div>
    </div>
  )
}
